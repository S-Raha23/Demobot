# Copy to .env and fill in. Never commit .env.

# Meta Model API ($150 credits). https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Baseten: Muse Spark Open ($100 credits). The hackathon key works only with this exact model name.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
MODEL_SPARK_OPEN=meta-models/muse-spark-open-1026

# Modal: Shared Endpoint for Muse Spark Open (workspace proxy token wk-<id>.ws-<secret>)
MODAL_API_KEY=
MODAL_BASE_URL=
MODEL_SPARK_OPEN_MODAL=meta-models/Muse-Spark-Open-816B-A42B
# Set to 0 if the hackathon credit does not cover Shared Endpoint usage (see docs/03 PROBE)
MODAL_LLM=1
# Modal Sandboxes use the token stored by `modal token new` (~/.modal.toml); nothing needed here.

# Hugging Face token with write access (for creating the Space)
HF_TOKEN=
HF_SPACE_NAME=the-demobot

# App
DEMOBOT_MODE=dev            # dev | replay | judge
DEMOBOT_FIXTURES=0          # 1 = offline tests with recorded responses
DATA_DIR=data
