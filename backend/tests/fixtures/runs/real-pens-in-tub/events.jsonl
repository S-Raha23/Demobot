{"ts":"2026-10-31T17:53:15.630Z","run_id":"real-pens-in-tub","seq":69,"stage":"program","type":"artifact","payload":{"name":"v1.py","path":"artifacts/programs/v1.py","kind":"code","label":"Program v1","diff":"--- v0.py\n+++ v1.py\n@@ -0,0 +1,14 @@\n+def run(scene, robot):\n+    tub = scene.get(\"white tub\")\n+    targets = []\n+    for obj in scene.of_kind(\"pen\") + scene.with_role(\"moved\"):\n+        if obj.name not in targets:\n+            targets.append(obj.name)\n+    log(\"targets: \" + str(targets))\n+    for name in targets:\n+        cur = scene.get(name)\n+        dst = scene.get(tub.name)\n+        if scene.is_inside(cur, dst):\n+            continue\n+        robot.pick(cur)\n+        robot.place_in(scene.get(tub.name))\n"}}
